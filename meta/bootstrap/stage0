#!/bin/bash

set -euo pipefail
shopt -s globstar nullglob

OUT=.cache/stage0
mkdir -p "$OUT"
: > "$OUT/edges"; : > "$OUT/map"

FLAGS=(
    -std=gnu++2c
    -Isrc/karm-core/includes
    -Isrc/karm-sys/includes
    -Isrc/karm-sys/posix/includes
    -D__ck_sys_encoding_utf8__
    -D__ck_sys_line_ending_lf__
    -D__ck_sys_path_separator_slash__
)

LDFLAGS=(
    -lunwind
)

FILES=(
    src/karm-core/*.cpp
    src/karm-core/*/*.cpp
    src/karm-math/*.cpp
    src/karm-crypto/*.cpp
    src/karm-crypto/urand/*.cpp
    src/karm-ref/*.cpp
    src/karm-sys/*.cpp
    src/karm-sys/base/*.cpp
    src/karm-sys/posix/*.cpp
    src/karm-sys/epoll/*.cpp
    src/karm-diag/*.cpp
    src/karm-tty/*.cpp
    src/karm-sh/*.cpp
    src/karm-cli/*.cpp
    src/karm-debug/*.cpp
    src/karm-glob/*.cpp
    src/utilities/shell/*.cpp
)
PLAIN=()


for f in "${FILES[@]}"; do
    m=$(sed -n 's/^export module \([A-Za-z0-9_.:]*\);.*/\1/p' "$f")
    impl=$(sed -n 's/^module \([A-Za-z0-9_.:]*\);.*/\1/p' "$f")

    if [ -n "$impl" ] && [[ $impl != *:* ]]; then
        PLAIN+=("$f")                       # object only, no BMI
        continue
    fi
    m=${m:-$impl}                           # module M:part; is importable
    [ -z "$m" ] && { PLAIN+=("$f"); continue; }
    printf '%s\t%s\n' "$m" "$f" >> "$OUT/map"
    printf '__root__\t%s\n' "$m" >> "$OUT/edges"
    primary=${m%%:*}
    sed -n 's/^\(export \)\?import \([A-Za-z0-9_.:]*\);.*/\2/p' "$f" \
        | sed "s|^:|$primary:|" \
        | sed "s|\$|\t$m|" >> "$OUT/edges"
done

tsort "$OUT/edges" > "$OUT/order" || { echo "module cycle"; exit 1; }
ORDER=()
MODS=()
for m in $(cat "$OUT/order"); do
    f=$(awk -F'\t' -v m="$m" '$1==m{print $2}' "$OUT/map")
    [ -z "$f" ] && continue
    pcm="$OUT/${m//:/-}.pcm"
    echo "$f"
    clang++ "${FLAGS[@]}" "${MODS[@]}" -x c++-module "$f" --precompile -o "$pcm"
    MODS+=("-fmodule-file=$m=$pcm")
    ORDER+=("$pcm")
done

clang++ "${FLAGS[@]}" "${LDFLAGS[@]}" "${MODS[@]}" "${ORDER[@]}" "${PLAIN[@]}" -o "$OUT/stage0"
